# ── Sem nada preenchido, o CRM abre em MODO DEMONSTRAÇÃO (dados fictícios no navegador).

# Supabase do CRM (o MESMO projeto que o CRM antigo usa — Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Integração com o Elo (só no servidor — nunca use NEXT_PUBLIC_ aqui)
# ELO_API_URL: endereço do Elo na Vercel, sem barra no final. Ex.: https://elo-atendimento.vercel.app
# ELO_API_KEY: chave criada no Elo em Integrador → API (começa com elo_)
ELO_API_URL=
ELO_API_KEY=

# Esteira de contatos (Elo → CRM)
# ELO_WEBHOOK_SECRET: segredo do webhook criado no Elo (Integrador → Webhooks)
# SUPABASE_SERVICE_ROLE_KEY: Supabase DO CRM (Settings → API). Só servidor.
ELO_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
