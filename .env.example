# ── Sem nada preenchido, o CRM abre em MODO DEMONSTRAÇÃO (dados fictícios no navegador).

# Supabase do CRM (o MESMO projeto que o CRM antigo usa — Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Integração com o Elo (só no servidor — nunca use NEXT_PUBLIC_ aqui)
# ELO_API_URL: endereço do Elo na Vercel, sem barra no final. Ex.: https://elo-atendimento.vercel.app
# ELO_API_KEY: chave criada no Elo em Integrador → API (começa com elo_)
ELO_API_URL=
ELO_API_KEY=

# Esteira de contatos (Elo → CRM)
# ELO_WEBHOOK_SECRET: segredo do webhook criado no Elo (Integrador → Webhooks)
# SUPABASE_SERVICE_ROLE_KEY: Supabase DO CRM (Settings → API). Só servidor.
ELO_WEBHOOK_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# Agenda → Google Agenda na hora (conta de serviço; sem isso o CRM funciona, só não espelha no Google)
# 1. Crie um calendário novo no Google Agenda ("ThiagoCRM · Agenda").
# 2. Google Cloud: ative a Google Calendar API → Credenciais → Conta de serviço → Chaves → JSON.
# 3. Compartilhe o calendário com o e-mail da conta de serviço, com "Fazer alterações nos eventos".
# GOOGLE_SA_EMAIL: client_email do JSON (termina em .iam.gserviceaccount.com)
# GOOGLE_SA_PRIVATE_KEY: private_key do JSON, INTEIRA, com BEGIN e END (os \n podem ficar escapados)
# GOOGLE_CALENDAR_ID: Configurações do calendário → Integrar agenda
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_ID=

# Importar leads → Google Maps: chave da Places API (New) no Google Cloud (com faturamento ativo).
# Restrinja a chave à "Places API (New)". Só servidor: NUNCA use NEXT_PUBLIC_ aqui.
GOOGLE_PLACES_API_KEY=
